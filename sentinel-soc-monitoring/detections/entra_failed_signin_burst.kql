// Microsoft Entra ID failed sign-ins grouped by account and source IP.
// Tune thresholds to your environment; this is a candidate signal, not proof of attack.
let lookback = 1h;
let windowSize = 15m;
let minFailures = 8;
SigninLogs
| where TimeGenerated >= ago(lookback)
| where ResultType != "0"
| where isnotempty(UserPrincipalName) and isnotempty(IPAddress)
| summarize FailureCount = count(), FirstSeen = min(TimeGenerated), LastSeen = max(TimeGenerated),
            ErrorCodes = make_set(ResultType, 10), Apps = make_set(AppDisplayName, 10)
    by UserPrincipalName, IPAddress, bin(TimeGenerated, windowSize)
| where FailureCount >= minFailures
| project WindowStart = TimeGenerated, FirstSeen, LastSeen, UserPrincipalName, IPAddress,
          FailureCount, ErrorCodes, Apps
| order by FailureCount desc
