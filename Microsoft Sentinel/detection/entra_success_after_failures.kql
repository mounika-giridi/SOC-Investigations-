// Finds successful Entra sign-ins following >=5 failures for same user + IP in prior 30m.
// Interpret with caution: user password corrections can produce this pattern.
let lookback = 24h;
let failureWindow = 30m;
let minFailures = 5;
let Signins = materialize(
    SigninLogs
    | where TimeGenerated >= ago(lookback)
    | where isnotempty(UserPrincipalName) and isnotempty(IPAddress)
    | project TimeGenerated, UserPrincipalName, IPAddress, ResultType, AppDisplayName
);
let Failures = Signins
    | where ResultType != "0"
    | project FailureTime = TimeGenerated, UserPrincipalName, IPAddress;
let Successes = Signins
    | where ResultType == "0"
    | project SuccessTime = TimeGenerated, UserPrincipalName, IPAddress, SuccessfulApp = AppDisplayName;
Successes
| join kind=inner (Failures) on UserPrincipalName, IPAddress
| where FailureTime < SuccessTime and FailureTime >= SuccessTime - failureWindow
| summarize PriorFailureCount = count(), FirstFailure = min(FailureTime), LastFailure = max(FailureTime)
    by UserPrincipalName, IPAddress, SuccessTime, SuccessfulApp
| where PriorFailureCount >= minFailures
| order by SuccessTime desc
